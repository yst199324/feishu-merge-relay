# ------------------------------------------------------------------
# 配置模板。真实值写在 .env 里，这个文件（.env.example）进仓库。
#
# 本地开发：cp .env.example .env   然后把下面的值换成你自己的
# 服务器部署：.env 和 application.yml 一起放在 jar 同级目录
#
# .env 已被 .gitignore 排除，不会进仓库 —— 真实值写这里安全。
#
# 为什么真实值要单独放这个文件：
#   application.yml 里只写结构（${KEY:占位} 形式），不含真实值。
#   所以本地改完 yml 可以直接整份覆盖到服务器，
#   服务器上的真实值从它自己的 .env 读，一点不受影响。
#
# 注意：.env 是相对「进程工作目录」读的，所以 start.sh 里必须先 cd 到
#       脚本所在目录，否则会静默读不到（不报错、直接用占位值）。
# ------------------------------------------------------------------

# 【必填 1】云效 Webhook 的 Secret Token
# 要同时满足两处：
#   1. 云效「代码库 -> 设置 -> Webhooks」里填的那个
#   2. 合并项目 .env 里的 YUNXIAO_WEBHOOK_TOKEN
# 三处必须完全一致，差一个字符就是 403。
YUNXIAO_WEBHOOK_TOKEN=在这里填一个随机字符串

# 【必填 2】合并项目的内部入口地址
# 同机部署就是 127.0.0.1；将来分机器就填合并项目那台机器的内网地址。
# 注意：合并项目那边要把 INTERNAL_ENDPOINT 设成 true，否则这个地址返回 404。
RELAY_TARGET_URL=http://127.0.0.1:18601/internal/yunxiao


# ------------------------- 以下都有默认值，一般不用动 -------------------------

# 监听端口。云效的 Webhook 地址指向这个端口，必须对外开放。
# RELAY_SERVER_PORT=18123

# 队列根目录，下面自动建 pending / retry / dead 三个子目录
# RELAY_QUEUE_DIR=./queue

# 消息总寿命（分钟），从「云效推过来那一刻」算起，两个队列共用。
# ⚠️ 必须大于重试阶梯累计时长（5+30+120+300+1800+7200 秒 ≈ 2 小时 38 分），
#    否则最后一档 2 小时重试还没跑到，消息就已经被判超龄进死信了。
#    改 application.yml 里的 delay-seconds 时，记得回来检查这个值。
# RELAY_MAX_AGE_MINUTES=180

# 待发队列上限（条）
# RELAY_PENDING_MAX_SIZE=50

# 重试队列上限（条）
# RELAY_RETRY_MAX_SIZE=50

# 死信保留天数，过期直接删文件。报文里有提交人姓名和邮箱，不留太久。
# RELAY_DEAD_MAX_AGE_DAYS=7

# 转发时等合并项目响应的超时（毫秒），默认 120000。
# 为什么是 120 秒而不是 30 秒：合并项目同步处理一条要串行调最多 3 次云效接口
#   （每次"连接 5s + 读 20s"上限）再发一次飞书卡片，最坏约 85 秒。
#   设短了会出现"它其实成功了、我们判成失败"→ 重投 → 靠投递编号去重挡住，但白占一次重试名额。
# 调大只影响"判定失败"的早晚，不影响正确性；不建议超过 180000
#   （待发队列串行，一条卡住会把整轮拖住那么久）。
# RELAY_TARGET_READ_TIMEOUT_MS=120000
