target/
logs/
*.log
.idea/
*.iml

# 队列目录：报文里有提交人姓名和邮箱，绝不入库。
# ⚠️ 必须是 /queue/（只匹配仓库根目录那一份）。写成 queue/ 会连带忽略
# src/main/java/com/yiyu/relay/queue/ 和 src/test/.../queue/ —— 源码包被排除在仓库外，
# 本地能编译（文件在磁盘上）、克隆下来却编译不过。这个坑真踩过。
/queue/
*.pid

# 本地开发的真实配置，不入库。模板见 .env.example
# 只忽略根目录那个 .env，不影响 .env.example
/.env

# 服务器上的真实值（云效密钥 + 目标地址），不入库。模板见 deploy/.env.example
deploy/.env

# 构建产物不入库：deploy 下那份是拷过去方便启动的副本
deploy/*.jar
